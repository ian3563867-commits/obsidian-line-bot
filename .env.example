LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_ALLOWED_USER_ID=your_line_user_id_here

# Vault 路徑（預設 G:\MyDrive\my-vault）
# VAULT_DIR=G:\MyDrive\my-vault

# Obsidian vault 名稱（保留備用；目前 LINE 連結直接用網頁顯示筆記內容）
# OBSIDIAN_VAULT_NAME=my-vault

# 開啟筆記用的公開網址（通常填 ngrok https 網址；未填時會用 webhook request 的 base URL）
# OPEN_NOTE_BASE_URL=https://xxxx.ngrok-free.app

# Agent backend（預設 claude；codex 仍在測試，確認可執行後再切）
# AGENT_BACKEND=claude

# Claude 執行方式：
# - 筆電（claude 在 PATH）：下面兩行留空或不填
# - 家裡主機（Store Python，看不到 Roaming npm）：填絕對路徑
# NODE_PATH=C:\Program Files\nodejs\node.exe
# CLAUDE_JS_PATH=C:\npm-global\node_modules\@anthropic-ai\claude-code\cli.js

# Codex 執行方式：
# - 預設使用 codex exec "<prompt>"
# - 若 WindowsApps 的 codex.exe 顯示 Access is denied，請改填真正可執行的 Codex CLI 路徑
# CODEX_EXE=codex
# CODEX_ARGS=exec --sandbox workspace-write -
# CODEX_TIMEOUT_SECONDS=180

# ngrok 執行檔路徑（預設用 PATH 的 ngrok）
# NGROK_EXE=C:\path\to\ngrok.exe
